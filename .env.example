# Przykładowe zmienne środowiskowe dla FIRE Simulator.
# Skopiuj do `.env` (lub ustaw w panelu hostingu) i wypełnij wartościami.

# production / development(domyślnie brak = development)
# production wyłącza /docs, włącza https_only i wymusza FIRE_SECRET_KEY z env.
FIRE_ENV=production

# Klucz sesji. W produkcji MUSI być ustawiony (wygeneruj np. `openssl rand -hex 32`).
# NIGDY nie zapisuj go w repo — tylko env / panel sekretów hostingu.
FIRE_SECRET_KEY=

# Opcjonalna ścieżka pliku sekretu (tylko do rozwoju lokalnego).
# FIRE_SECRET_FILE=.secret_key

# Ścieżka do pliku SQLite. W produkcji wskaż katalog trwały hostingu
# (np. mountPath dysku). Bez tego dane znikną przy redeploy.
FIRE_DB=/var/data/fire.db
